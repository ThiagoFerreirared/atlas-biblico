---
import Base from '../../layouts/Base.astro';
import { aulas } from '../../data/catalogo-aulas.js';
import { textoDaReferencia } from '../../data/referencias.js';
import { ligaReferencia } from '../../data/estudo.js';
export function getStaticPaths(){
  return aulas.map(a=>({params:{numero:String(a.numero)},props:{a}}));
}
const {a}=Astro.props;
const prev=a.numero>1?a.numero-1:null;
const next=a.numero<aulas.length?a.numero+1:null;
---
<Base title={'Aula '+String(a.numero).padStart(2,'0')+' — '+a.titulo}>
  <div class="breadcrumbs"><a href="/">Biblioteca</a> / <a href="/estudos/">Aulas</a> / <span class="gold">Aula {String(a.numero).padStart(2,'0')}</span></div>
  <section class="intro"><span class="eyebrow">{a.categoria} · Aula {String(a.numero).padStart(2,'0')} de {aulas.length}</span><h1>{a.titulo}</h1><p class="muted">Atlas Bíblico · Explicações e referências bíblicas</p></section>
  <div class="notice">Esta aula reúne explicações, temas e referências para acompanhar sua leitura. Os resumos das passagens relacionadas são <strong>paráfrases de estudo</strong>; para ler o texto bíblico integral, abra a referência.</div>
  <div class="layout">
    <div class="body">
      <section id="explicacoes"><div class="section-heading"><h2>Explicações e análise</h2><span class="tag">{a.secoes.length} tópicos</span></div>
        {a.secoes.map((s,i)=><article class="card paragraph" id={'topico-'+(i+1)}><span class="eyebrow">Tópico {String(i+1).padStart(2,'0')}</span><h3>{s.titulo}</h3><p>{s.texto}</p></article>)}
      </section>
      <section id="referencias"><div class="section-heading"><h2>Referências cruzadas</h2><span class="tag">{a.referencias.length} passagens</span></div>
        {a.referencias.map(r=>{
          const biblia=textoDaReferencia(r.referencia);
          const link=ligaReferencia(r.referencia);
          return <article class="card ref">
            <div class="ref-head"><h3>{r.referencia}</h3><span class="chip">Paráfrase de estudo</span></div>
            <blockquote>“{r.texto}”</blockquote>
            <p><strong class="gold">Conexão:</strong> {r.conexao}</p>
            {biblia&&<details class="full-text"><summary>Ler texto integral · {biblia.fonte||'Bíblia Livre'}</summary>
              <div class="biblical-text">{biblia.versiculos.map(v=><p><span class="gold">{v.numero}</span> {v.texto}</p>)}</div>
              <p class="muted" style="font-size:11px">{biblia.fonte||'BLIVRE (2018), Diego Santos, Mario Sérgio e Marco Teles. CC BY 3.0 Brasil.'}</p>
            </details>}
            {link&&<a href={link} class="text-link gold" style="font-size:13px">Estudar versículo no Atlas →</a>}
          </article>;
        })}
      </section>
      <section id="registro"><div class="section-heading"><h2>Notas de investigação</h2></div><div class="card"><p>{a.registro}</p></div></section>
      <div class="controls bottom"><a class="btn secondary" href={prev?'/estudos/'+prev+'/':'/estudos/'}>← {prev?'Aula anterior':'Todas as aulas'}</a><a class="btn" href={next?'/estudos/'+next+'/':'/estudos/'}>{next?'Próxima aula':'Todas as aulas'} →</a></div>
    </div>
    <aside><div class="card aside"><span class="eyebrow">Nesta aula</span><a href="#explicacoes">Explicações e análise</a><a href="#referencias">Referências cruzadas</a><a href="#registro">Notas da edição</a><hr/><a href="/estudos/">← Índice das aulas</a>{a.numero>=6&&<a href="/livros/genesis/">↗ Livro de Gênesis</a>}</div></aside>
  </div>
</Base>
<style>
  .layout{display:grid;grid-template-columns:minmax(0,1fr) 230px;gap:28px;margin-top:24px;align-items:start}.paragraph{margin-bottom:13px}.paragraph h3{margin:9px 0;font-size:19px;color:var(--text)}.paragraph p{line-height:1.85}.ref{margin-bottom:13px}.ref-head{display:flex;align-items:center;justify-content:space-between;gap:10px}.ref-head h3{color:var(--gold)}.ref blockquote{margin:12px 0;font-family:Georgia,serif;font-size:18px;line-height:1.7;border-left:2px solid var(--gold);padding-left:16px}.ref p{font-size:14px;color:var(--muted)}.full-text{background:var(--card2);padding:12px 15px;border-radius:10px;margin-top:15px;border:1px solid var(--line)}.full-text summary{cursor:pointer;color:var(--gold);font-size:13px}.biblical-text{font:17px/1.8 Georgia,serif;margin:12px 0}.biblical-text p{color:var(--text);font:inherit}.biblical-text p+p{margin-top:8px}.aside{position:sticky;top:95px;display:flex;flex-direction:column;gap:12px;font-size:13px}.aside a{color:var(--muted)}.aside a:hover{color:var(--gold)}.aside hr{width:100%;border:0;border-top:1px solid var(--line)}.bottom{justify-content:space-between;margin-top:30px}@media(max-width:850px){.layout{display:block}aside{display:none}}@media(max-width:600px){.bottom{display:grid;grid-template-columns:1fr}.bottom .btn{width:100%}}
</style>
