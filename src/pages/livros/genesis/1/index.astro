---
import Base from '../../../../layouts/Base.astro';
import {amostra} from '../../../../data/biblia.js';
import {aulasDoCapitulo} from '../../../../data/cobertura.js';
---
<Base title="Gênesis 1 — Capítulo">
  <div class="breadcrumbs"><a href="/">Biblioteca</a> / <a href="/livros/genesis/">Gênesis</a> / <span class="gold">Capítulo 1</span></div>
  <section class="intro"><span class="eyebrow">Gênesis · Capítulo 1</span><h1>O início da criação</h1><p class="muted">Leia o capítulo e selecione um versículo para explorar seus módulos de estudo.</p></section>
  <div class="notice">Esta leitura contínua mostra apenas os três primeiros versículos. As aulas do PDF cobrem Gênesis 1:1–31. Consulte os estudos por trecho abaixo.</div>
  <div class="controls"><label for="leitura" class="muted">Modo de leitura</label><select id="leitura" class="field"><option value="continua">Leitura contínua</option><option value="separada">Por versículos</option></select></div>
  <section id="texto" class="reading continuous" aria-label="Texto bíblico">
    {amostra.versos.map(v=><button class="verse" data-verse={v.numero} aria-label={'Prévia de Gênesis 1:'+v.numero}><span class="verse-number">{v.numero}</span>{v.texto}</button>)}
  </section>
  <p class="muted" style="font-size:12px;margin-top:12px">Toque em um versículo para abrir uma prévia rápida. A partir dela, você poderá abrir a página de estudo completa.</p>
  <div class="section-heading"><h2>Aulas do capítulo completo</h2><span class="tag">Gênesis 1:1–31</span></div>
  <div class="grid two">
    {aulasDoCapitulo(1).map(a=><a class="card" href={'/estudos/'+a.aula+'/'}><span class="eyebrow">Aula {String(a.aula).padStart(2,'0')} · Gênesis {a.faixa}</span><h3 style="margin-top:8px">{a.tema}</h3><p class="gold" style="font-size:13px;margin-top:8px">Ler estudo →</p></a>)}
  </div>
  <div class="controls"><a class="btn secondary" href="/livros/genesis/">← Voltar a Gênesis</a><a class="btn" href="/livros/genesis/1/1/">Estudar Gênesis 1:1 →</a></div>
  <dialog id="preview" aria-labelledby="preview-title">
    <div class="dialog-header"><div><span class="eyebrow">Prévia do versículo</span><h2 id="preview-title"></h2></div><button id="close" class="btn secondary small" aria-label="Fechar prévia">✕ Fechar</button></div>
    <div class="verse-box" id="preview-text"></div>
    <p class="muted" style="margin-top:14px">Explore os seis módulos, conexões bíblicas e seu progresso na página completa do versículo.</p>
    <div class="controls"><a id="study" class="btn" href="/livros/genesis/1/1/">Abrir estudo completo →</a><button class="btn secondary" id="close-bottom">Voltar ao capítulo</button></div>
  </dialog>
</Base>
<style>
  .reading{font-family:Georgia,serif;font-size:20px;line-height:2;background:var(--card2);border-radius:14px;border:1px solid var(--line);padding:25px}.verse{font:inherit;text-align:left;background:none;border:0;color:var(--text);padding:3px 4px}.verse:hover{background:#3b352d;border-radius:5px}.reading.separated{display:grid;gap:12px;background:transparent;border:0;padding:0}.reading.separated .verse{display:block;background:var(--card);border:1px solid var(--line);padding:20px;border-radius:12px}dialog{width:min(640px,calc(100vw - 28px));border:1px solid #746045;border-radius:16px;background:var(--card);color:var(--text);padding:25px;box-shadow:0 20px 90px #0009}dialog::backdrop{background:#000b}.dialog-header{display:flex;justify-content:space-between;gap:14px;align-items:start;margin-bottom:20px}.dialog-header h2{margin-top:6px}@media(max-width:600px){.reading{font-size:18px;padding:16px}dialog{padding:16px}}
</style>
<script>
  const reading=document.getElementById('texto'),select=document.getElementById('leitura'),dialog=document.getElementById('preview');
  select.addEventListener('change',()=>{reading.classList.toggle('separated',select.value==='separada');reading.classList.toggle('continuous',select.value==='continua')});
  for(const button of reading.querySelectorAll('[data-verse]'))button.addEventListener('click',()=>{
    const number=button.dataset.verse;
    document.getElementById('preview-title').textContent='Gênesis 1:'+number;
    document.getElementById('preview-text').textContent=button.textContent.trim();
    document.getElementById('study').href='/livros/genesis/1/'+number+'/';
    dialog.showModal();
  });
  document.getElementById('close').addEventListener('click',()=>dialog.close());
  document.getElementById('close-bottom').addEventListener('click',()=>dialog.close());
  dialog.addEventListener('click',(e)=>{if(e.target===dialog)dialog.close()});
</script>
