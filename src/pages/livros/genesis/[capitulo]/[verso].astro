---
import VerseStudy from '../../../../components/VerseStudy.astro';
import { textoGenesis } from '../../../../data/texto-genesis.js';
export function getStaticPaths(){
  return [2,3,4].flatMap(c=>textoGenesis[c].map(v=>({params:{capitulo:String(c),verso:String(v.numero)},props:{c,n:v.numero}})));
}
const {c,n}=Astro.props;
---
<VerseStudy capitulo={c} versiculo={n} />
