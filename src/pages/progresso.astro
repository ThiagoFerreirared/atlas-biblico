---
import Base from '../layouts/Base.astro';
---
<Base title="Meu progresso e revisões">
  <div class="breadcrumbs"><a href="/">Biblioteca</a> / <span class="gold">Meu progresso</span></div>
  <section class="intro"><span class="eyebrow">Acompanhamento pessoal</span><h1>Minha jornada pelo Atlas</h1><p class="muted">Acompanhe sua leitura, os módulos concluídos e o progresso dos estudos, salvos neste navegador.</p></section>
  <div class="notice">Os registros desta página são pessoais e locais. Não são sincronizados entre dispositivos. Seu progresso começa quando você utiliza os módulos neste navegador.</div>
  <div class="stats">
    <div class="card stat"><span class="eyebrow">Leitura</span><strong id="read-count">—</strong><p>de 80 versículos disponíveis em Gênesis 1–3</p></div>
    <div class="card stat"><span class="eyebrow">Estudo</span><strong id="done-count">—</strong><p>de 71 versículos com estudos aprofundados</p></div>
    <div class="card stat"><span class="eyebrow">Módulos</span><strong id="module-count">—</strong><p>de 426 módulos possíveis</p></div>
    <div class="card stat"><span class="eyebrow">Revisões vencidas</span><strong id="due-count">—</strong><p>ciclo opcional de 1, 7 e 30 dias</p></div>
  </div>
  <div class="section-heading"><h2>Por capítulo</h2></div>
  <div class="grid">
    {[1,2,3].map(n=><a href={'/livros/genesis/'+n+'/'} class="card chapter-stat" data-chapter-summary={n}><span class="eyebrow">Gênesis</span><h3>Capítulo {n}</h3><p class="muted" data-ch-read>Leitura —</p><div class="meter"><div data-read-fill></div></div><p class="muted" data-ch-done>Estudo —</p><div class="meter"><div data-study-fill></div></div><span class="gold" style="font-size:12px">Continuar estudo →</span></a>)}
  </div>
  <div class="section-heading"><h2>Revisões espaçadas</h2><span class="tag">1 · 7 · 30 dias</span></div>
  <p class="muted" style="margin-bottom:13px">Após concluir os seis módulos de um versículo, ele entra no ciclo de revisão. Ao revisar, marque a revisão na própria página do versículo.</p>
  <div class="card"><h3>Revisões disponíveis agora</h3><div id="due-list" class="review-list"><p class="muted">Nenhuma revisão pendente.</p></div><hr/><h3>Próximas revisões</h3><div id="next-list" class="review-list"><p class="muted">Nenhuma revisão programada.</p></div></div>
  <div class="controls"><a href="/estudos/" class="btn secondary">Ver as 25 aulas</a><a href="/estudos/debates/" class="btn secondary">Temas em discussão</a></div>
</Base>
<style>
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin:25px 0}.stat{display:grid;gap:5px}.stat strong{font-size:31px;color:var(--gold)}.stat p{font-size:12px;color:var(--muted)}.chapter-stat{display:grid;gap:9px}.chapter-stat h3{font-size:20px}.chapter-stat p{font-size:12px}.meter{height:7px;border-radius:10px;background:#343a40;overflow:hidden}.meter div{height:100%;width:0;background:var(--gold)}.review-list{padding-top:15px;display:grid;gap:8px}.review-list a{display:flex;align-items:center;justify-content:space-between;gap:10px;border:1px solid var(--line);border-radius:9px;padding:10px 13px}.review-list a:hover{border-color:var(--gold)}.review-list .muted{font-size:12px}hr{border:0;border-top:1px solid var(--line);margin:23px 0}@media(max-width:700px){.stats{grid-template-columns:1fr 1fr}}@media(max-width:400px){.stats{grid-template-columns:1fr}}
</style>
<script>
import {summary} from '../scripts/progresso.js';
const s=summary();
document.getElementById('read-count').textContent=s.read;
document.getElementById('done-count').textContent=s.studied;
document.getElementById('module-count').textContent=s.modulesDone;
document.getElementById('due-count').textContent=s.due.length;
for(const card of document.querySelectorAll('[data-chapter-summary]')){
 const c=Number(card.dataset.chapterSummary),d=s.byChapter[c];
 card.querySelector('[data-ch-read]').textContent=d.read+' de '+d.total+' versículos lidos';
 card.querySelector('[data-ch-done]').textContent=d.done+' de '+d.studiedTotal+' versículos com estudo concluído';
 card.querySelector('[data-read-fill]').style.width=(d.read/d.total*100)+'%';
 card.querySelector('[data-study-fill]').style.width=(d.done/d.studiedTotal*100)+'%';
}

function display(items,target,empty){
 const list=document.getElementById(target);list.replaceChildren();
 if(!items.length){const p=document.createElement('p');p.className='muted';p.textContent=empty;list.append(p);return;}
 for(const item of items.slice(0,40)){
   const a=document.createElement('a');a.href='/livros/genesis/'+item.chapter+'/'+item.verse+'/';
   const name=document.createElement('strong');name.textContent='Gênesis '+item.chapter+':'+item.verse;
   const date=document.createElement('span');date.className='muted';date.textContent=new Date(item.when).toLocaleDateString('pt-BR');
   a.append(name,date);list.append(a);
 }
}
display(s.due,'due-list','Nenhuma revisão vencida. Continue seu estudo.');
display(s.next,'next-list','Nenhuma revisão futura programada.');
</script>
