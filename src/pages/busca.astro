---
import Base from '../layouts/Base.astro';
import { livros } from '../data/biblia.js';
import { aulas } from '../data/aulas.js';
import { textoGenesis } from '../data/texto-genesis.js';
const results=[
  ...livros.map(l=>({tipo:'Livro bíblico',titulo:l.nome,descricao:l.categoria+' · '+l.capitulos+' capítulos',conteudo:l.nome+' '+l.categoria,href:l.nome==='Gênesis'?'/livros/genesis/':'/'})),
  ...aulas.map(a=>({tipo:'Aula '+String(a.numero).padStart(2,'0'),titulo:a.titulo,descricao:a.categoria+' · '+a.secoes.length+' tópicos · '+a.referencias.length+' referências',conteudo:[a.titulo,...a.secoes.map(s=>s.titulo+' '+s.texto),...a.referencias.map(r=>r.referencia+' '+r.texto+' '+r.conexao),...a.perguntas].join(' '),href:'/estudos/'+a.numero+'/'})),
  ...[1,2,3].flatMap(c=>textoGenesis[c].map(v=>({tipo:'Texto bíblico · Gênesis '+c,titulo:'Gênesis '+c+':'+v.numero,descricao:'Bíblia Livre (BLIVRE)',conteudo:'Gênesis '+c+':'+v.numero+' '+v.texto,href:'/livros/genesis/'+c+'/'+v.numero+'/'})))
];
const json=JSON.stringify(results).replace(/</g,'\\u003c');
---
<Base title="Busca no Atlas Bíblico">
  <div class="breadcrumbs"><a href="/">Biblioteca</a> / <span class="gold">Buscar</span></div>
  <section class="intro"><span class="eyebrow">Pesquisa no acervo</span><h1>O que deseja estudar?</h1><p class="muted">Pesquise entre os 66 títulos da biblioteca, os conteúdos das 24 aulas, suas conexões e o texto integral de Gênesis 1–3.</p></section>
  <div class="searchbox"><input id="global-search" type="search" class="field" autocomplete="off" placeholder="Ex.: bereshit, ezer kenegdo, João 1, Gênesis 2:7..." aria-label="Pesquisar no Atlas Bíblico"/><button type="button" id="clear" class="btn secondary">Limpar</button></div>
  <p id="count" class="muted" aria-live="polite">Digite um termo para pesquisar.</p>
  <div id="results" class="search-results" aria-live="polite"></div>
  <p class="notice" style="margin-top:28px">A busca funciona localmente, sem enviar sua pesquisa a um servidor. Ela cobre o conteúdo já importado; livros ainda não estudados aparecem apenas pelo nome e categoria.</p>
  <script id="atlas-index" type="application/json" set:html={json} />
</Base>
<style>
.searchbox{display:flex;gap:12px;margin:20px 0}.searchbox input{flex:1;min-width:0;font-size:17px;padding:15px}.search-results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px;margin-top:18px}.search-item{display:grid;gap:8px;text-align:left}.search-item h3{font-size:19px}.search-item p{font-size:13px}.search-item span:last-child{font-size:12px}@media(max-width:650px){.search-results{grid-template-columns:1fr}.searchbox{flex-wrap:wrap}.searchbox input{flex-basis:100%}}
</style>
<script>
const input=document.getElementById('global-search'),area=document.getElementById('results'),count=document.getElementById('count');
const rows=JSON.parse(document.getElementById('atlas-index').textContent);
const norm=v=>String(v).normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
function search(){
 const query=norm(input.value).trim();area.replaceChildren();
 if(!query){count.textContent='Digite um termo para pesquisar.';return;}
 const words=query.split(/\s+/).filter(Boolean);
 const found=rows.map(r=>{const title=norm(r.titulo),content=norm(r.conteudo);let score=0;for(const word of words){if(!content.includes(word))return null;score+=(title.includes(word)?6:1);}return {row:r,score};}).filter(Boolean).sort((a,b)=>b.score-a.score||a.row.titulo.localeCompare(b.row.titulo,'pt-BR'));
 count.textContent=found.length+' resultado(s) encontrado(s)'+(found.length>40?' · exibindo os primeiros 40':'')+'.';
 if(!found.length){const p=document.createElement('p');p.className='muted';p.textContent='Não encontramos resultados. Tente outra palavra.';area.append(p);}
 for(const x of found.slice(0,40)){
   const r=x.row,a=document.createElement('a');a.className='card search-item';a.href=r.href;
   const tag=document.createElement('span');tag.className='eyebrow';tag.textContent=r.tipo;
   const title=document.createElement('h3');title.textContent=r.titulo;
   const description=document.createElement('p');description.className='muted';description.textContent=r.descricao;
   const open=document.createElement('span');open.className='gold';open.textContent='Abrir conteúdo →';
   a.append(tag,title,description,open);area.append(a);
 }
}
input.addEventListener('input',()=>{search();const url=new URL(location.href);if(input.value.trim())url.searchParams.set('q',input.value.trim());else url.searchParams.delete('q');history.replaceState(null,'',url)});
document.getElementById('clear').addEventListener('click',()=>{input.value='';input.dispatchEvent(new Event('input'));input.focus()});
const initial=new URLSearchParams(location.search).get('q');if(initial){input.value=initial;search();}
</script>
