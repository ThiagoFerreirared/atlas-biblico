---
const { title = 'Atlas Bíblico', description = 'Estudo enciclopédico das Escrituras, versículo por versículo.' } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#141619" />
  <title>{title} | Atlas Bíblico</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <header class="header">
    <div class="shell nav">
      <a href="/" class="brand" aria-label="Atlas Bíblico, início"><span class="brand-icon">✧</span><span>ATLAS <strong>BÍBLICO</strong></span></a>
      <nav aria-label="Navegação principal"><a href="/">Biblioteca</a><a href="/livros/genesis/">Gênesis</a><a href="/livros/genesis/1/">Ler capítulo</a></nav>
    </div>
  </header>
  <main class="shell"><slot /></main>
  <footer class="footer shell"><span>ATLAS BÍBLICO · Estudo enciclopédico das Escrituras</span><span>Projeto em desenvolvimento · Conteúdo demonstrativo</span></footer>
</body>
</html>
<style is:global>
  :root{color-scheme:dark;--bg:#141619;--card:#24282d;--card2:#1d2024;--line:#343a3f;--gold:#d8ae76;--text:#f3ede3;--muted:#aeb2b5;--green:#74c79a;font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
  *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);line-height:1.6}button,input,select{font:inherit}
  a{color:inherit;text-decoration:none}button{cursor:pointer}button:disabled{opacity:.4;cursor:not-allowed}.shell{max-width:1140px;margin:0 auto;padding:0 24px}
  .header{border-bottom:1px solid var(--line);background:#15181a;position:sticky;top:0;z-index:15}.nav{min-height:72px;display:flex;justify-content:space-between;align-items:center;gap:18px}
  .brand{display:flex;align-items:center;gap:10px;font-size:16px;letter-spacing:.12em;font-weight:650}.brand strong{color:var(--gold)}.brand-icon{color:var(--gold);font-size:32px}
  nav{display:flex;gap:22px}nav a{font-size:14px;color:var(--muted)}nav a:hover,.text-link:hover{color:var(--gold)}
  h1,h2,h3,p{margin:0}h1{font-size:clamp(32px,5vw,54px);letter-spacing:-.045em;line-height:1.15}h2{font-size:24px;line-height:1.3}h3{font-size:17px}.eyebrow{color:var(--gold);font-weight:700;letter-spacing:.13em;text-transform:uppercase;font-size:11px}
  .muted{color:var(--muted)}.intro{padding:60px 0 30px;display:grid;gap:15px}.intro p{max-width:690px}.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:20px}.card:hover:is(a,button),button.card:hover{border-color:#97774f}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.grid.two{grid-template-columns:repeat(2,minmax(0,1fr))}
  .section-heading{margin:28px 0 15px;display:flex;align-items:center;justify-content:space-between;gap:16px}.tag{font-size:12px;color:var(--gold);border:1px solid #655440;border-radius:30px;padding:4px 10px;white-space:nowrap}.label{display:block;font-size:12px;color:var(--muted);margin-bottom:5px}
  .btn{border:1px solid #796240;background:var(--gold);color:#20190f;border-radius:10px;padding:10px 16px;font-weight:700;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:43px}.btn:hover{filter:brightness(1.08)}.btn.secondary{background:transparent;color:var(--text);border-color:var(--line)}.btn.secondary:hover{border-color:var(--gold)}.btn.small{padding:7px 12px;min-height:35px;font-size:13px}.controls{display:flex;gap:12px;flex-wrap:wrap;margin:20px 0 26px;align-items:center}.field{background:var(--card);color:var(--text);border:1px solid var(--line);border-radius:9px;padding:11px;min-height:43px}.field:focus,.btn:focus-visible,a:focus-visible{outline:2px solid var(--gold);outline-offset:3px}.search{flex:1;min-width:180px}.breadcrumbs{padding-top:28px;color:var(--muted);font-size:13px;display:flex;gap:8px;flex-wrap:wrap}.breadcrumbs a:hover{color:var(--gold)}.gold{color:var(--gold)}
  .status{font-size:12px;color:var(--muted)}.chip{background:#39352b;border:1px solid #544936;border-radius:6px;color:var(--gold);font-size:11px;padding:3px 7px}.footer{border-top:1px solid var(--line);padding-top:30px;padding-bottom:35px;display:flex;justify-content:space-between;gap:12px;color:var(--muted);font-size:12px;margin-top:75px}
  .prose{max-width:780px;line-height:1.85}.prose p+p{margin-top:14px}.verse-box{font-family:Georgia,serif;font-size:clamp(19px,2.3vw,24px);line-height:1.9;background:var(--card2);border:1px solid var(--line);border-radius:14px;padding:24px}
  .verse-number{color:var(--gold);font:700 13px Inter,system-ui,sans-serif;margin-right:9px}.hidden{display:none!important}.notice{border-left:3px solid var(--gold);background:#272521;color:var(--muted);padding:12px 17px;border-radius:4px;font-size:13px}
  @media(max-width:720px){.shell{padding-left:16px;padding-right:16px}.nav{min-height:64px}.brand{font-size:12px}nav{gap:12px}nav a{font-size:12px}nav a:first-child{display:none}.grid,.grid.two{grid-template-columns:1fr 1fr}.intro{padding-top:38px}.footer{flex-direction:column}.section-heading{align-items:flex-start}.card{padding:15px}}
  @media(max-width:420px){.grid,.grid.two{grid-template-columns:1fr}.brand-icon{font-size:22px}}
</style>
