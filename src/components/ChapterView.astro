---
import Base from '../layouts/Base.astro';
import { textoGenesis, creditoTraducao } from '../data/texto-genesis.js';
import { aulasDoCapitulo } from '../data/cobertura.js';
import { aulas as aulasFonte } from '../data/catalogo-aulas.js';
import { trechoDoVersiculo, possuiEstudo, urlVerso } from '../data/estudo.js';
import { questoesDoCapitulo, urlQuestao } from '../data/questoes-abertas.js';

const { capitulo } = Astro.props;
const versos=textoGenesis[capitulo]||[];
const aulas=aulasDoCapitulo(capitulo);
const aulasOriginais=aulas.map(bloco=>({...bloco, original:aulasFonte.find(item=>item.numero===bloco.aula)}));
const cobertura=capitulo===3?'24 de 24':versos.length+' de '+versos.length;
const temasPendentes=questoesDoCapitulo(capitulo);
const roteiros={
  1:[
    {nome:'Abertura',faixa:'1:1–2',topico:'Princípio e condição inicial',verso:1},
    {nome:'Primeiro dia',faixa:'1:3–5',topico:'Luz, trevas, dia e noite',verso:3},
    {nome:'Segundo dia',faixa:'1:6–8',topico:'Expansão e separação das águas',verso:6},
    {nome:'Terceiro dia',faixa:'1:9–13',topico:'Terra, mares e vegetação',verso:9},
    {nome:'Quarto dia',faixa:'1:14–19',topico:'Luminares, sinais e tempos',verso:14},
    {nome:'Quinto dia',faixa:'1:20–23',topico:'Criaturas aquáticas e aves',verso:20},
    {nome:'Sexto dia',faixa:'1:24–31',topico:'Animais, humanidade e bondade',verso:24}
  ],
  2:[
    {nome:'Sétimo dia',faixa:'2:1–3',topico:'Descanso, bênção e santificação',verso:1},
    {nome:'O ser humano',faixa:'2:4–7',topico:'Solo, fôlego e ser vivente',verso:4},
    {nome:'O jardim',faixa:'2:8–14',topico:'Éden, árvores e quatro rios',verso:8},
    {nome:'A responsabilidade',faixa:'2:15–17',topico:'Cultivar, guardar e a proibição',verso:15},
    {nome:'A parceria',faixa:'2:18–20',topico:'O auxílio correspondente e os animais',verso:18},
    {nome:'A união',faixa:'2:21–25',topico:'A mulher, uma só carne e a nudez',verso:21}
  ],
  3:[
    {nome:'O diálogo',faixa:'3:1–5',topico:'A serpente, a ordem e o engano',verso:1},
    {nome:'A escolha',faixa:'3:6–7',topico:'A desobediência e a nudez',verso:6},
    {nome:'O encontro',faixa:'3:8–13',topico:'O esconderijo e as respostas',verso:8},
    {nome:'A sentença',faixa:'3:14–15',topico:'A serpente e a descendência da mulher',verso:14},
    {nome:'O solo',faixa:'3:16–19',topico:'Parto, domínio, trabalho e mortalidade',verso:16},
    {nome:'A expulsão',faixa:'3:20–24',topico:'Eva, vestes, árvore da vida e querubins',verso:20}
  ]
};
const roteiro=roteiros[capitulo]||[];
---
<Base title={'Gênesis '+capitulo+' — Leitura e estudos'}>
  <div class="breadcrumbs"><a href="/">Biblioteca</a> / <a href="/livros/genesis/">Gênesis</a> / <span class="gold">Capítulo {capitulo}</span></div>
  <section class="intro">
    <span class="eyebrow">Gênesis · Leitura integral</span>
    <h1>Gênesis {capitulo}</h1>
    <p class="muted">Leia todos os {versos.length} versículos do capítulo. Toque no número de um versículo para ver o texto, os assuntos relacionados e os seis módulos de estudo.</p>
  </section>
  <div class="controls" style="margin:0 0 22px"><a href="#conteudo-pdf" class="btn">Explorar os temas do capítulo ↓</a><a href="#chapter-reader" class="btn secondary">Ler o capítulo</a></div>
  <div class="reading-note"><span class="eyebrow">Texto bíblico</span><strong>{creditoTraducao.nome}</strong><span>{creditoTraducao.autores} · {creditoTraducao.ano} · <a href={creditoTraducao.licencaUrl} target="_blank" rel="noopener noreferrer">{creditoTraducao.licenca}</a></span></div>
  <div class="chapter-toolbar" data-chapter-id={capitulo}>
    <label for="reading-mode">Visualização</label>
    <select class="field" id="reading-mode"><option value="continua">Leitura contínua</option><option value="separada">Versículos separados</option></select>
    <a class="btn secondary small" href="/progresso/">Meu progresso</a>
    <span class="read-status" id="read-status">0 de {versos.length} lidos neste navegador</span>
  </div>
  <div class="chapter-reader" id="chapter-reader" aria-label={'Leitura de Gênesis '+capitulo}>
    {versos.map(v=>{
      const blocos=trechoDoVersiculo(capitulo,v.numero);
      const studied=possuiEstudo(capitulo,v.numero);
      const label=blocos.map(b=>'Gênesis '+b.faixa+' · '+b.tema).join(' | ');
      return <button type="button" class="read-verse" id={'v-'+v.numero} data-verse={v.numero} data-studied={studied?'1':'0'} data-lesson={label} aria-label={'Abrir Gênesis '+capitulo+':'+v.numero}>
        <span class="v-num">{v.numero}</span><span class="v-text" data-verse-text>{v.texto}</span><span class="read-indicator" aria-hidden="true"></span>
      </button>;
    })}
  </div>
  <p class="muted" style="font-size:12px;margin-top:12px">O texto bíblico acima é da Bíblia Livre, sob licença CC BY 3.0 Brasil. Os módulos dos versículos estudados incluem explicações passo a passo, hebraico quando relevante e interpretações comparadas.</p>
  <section class="genesis1-route" id="roteiro">
    <div class="section-heading"><h2>Roteiro aprofundado de Gênesis {capitulo}</h2><span class="tag">{capitulo===3?'13 versículos estudados':versos.length+' versículos estudados'}</span></div>
    <p class="muted" style="margin-bottom:16px">Escolha uma etapa para abrir os estudos por versículo, com explicações passo a passo, interpretações comparadas e palavras hebraicas quando relevantes.</p>
    <div class="genesis1-route-grid">
      {roteiro.map(item=><a href={'/livros/genesis/'+capitulo+'/'+item.verso+'/'} class="genesis1-route-card">
        <span class="eyebrow">{item.nome} · Gênesis {item.faixa}</span>
        <strong>{item.topico}</strong>
        <span class="gold">Estudar passagem →</span>
      </a>)}
    </div>
    {capitulo===3&&<p class="muted genesis1-route-note">O estudo aprofundado acompanha os versículos 1 a 13; o restante do capítulo está disponível para leitura.</p>}
  </section>

  <div class="controls"><a class="btn secondary" href="/progresso/">Acompanhar minha leitura →</a></div>
  <div class="section-heading"><h2>Assuntos estudados neste capítulo</h2><span class="tag">{aulas.length} aulas · {cobertura} versículos com estudo inicial</span></div>
  <p class="muted" style="margin-bottom:14px">Explore os temas das passagens e acesse o aprofundamento correspondente em cada versículo.</p>
  <div class="grid two">
    {aulas.map(a=><a class="card lesson" href={'/estudos/'+a.aula+'/'}><span class="eyebrow">Aula {String(a.aula).padStart(2,'0')} · Gênesis {a.faixa}</span><h3>{a.tema}</h3><span class="gold">Ler estudo completo →</span></a>)}
  </div>
  <section class="chapter-debates" id="questoes-em-aberto">
    <div class="section-heading"><h2>Questões para estudos futuros</h2><span class="tag">{temasPendentes.length} temas relacionados</span></div>
    <p class="muted" style="margin-bottom:16px">Debates que surgiram ao estudar este capítulo e podem ser aprofundados nas próximas aulas. Não são provas ou exercícios.</p>
    <details class="debate-details">
      <summary>Ver questões em aberto deste capítulo</summary>
      <div class="debate-grid">
        {temasPendentes.map(q=><a class="debate-link" href={urlQuestao(q.id)}>
          <span class="eyebrow">{q.id} · {q.estado}</span>
          <strong>{q.titulo}</strong>
          <span class="gold">Consultar tema →</span>
        </a>)}
      </div>
      <a class="all-debates-link" href="/estudos/debates/">Abrir o caderno completo de debates →</a>
    </details>
  </section>
  <section class="pdf-studies" id="conteudo-pdf">
    <div class="section-heading"><h2>Aprofundamentos e notas por assunto</h2><span class="tag">Acervo de estudos</span></div>
    <p class="muted" style="margin-bottom:18px">As explicações estão organizadas nos módulos de cada versículo. Aqui você encontra também os assuntos de cada aula, com as referências bíblicas e o histórico da investigação.</p>
    {aulasOriginais.map((entrada,i)=><details class="pdf-aula" id={'aula-'+entrada.aula} open={i===0}>
      <summary><span class="pdf-aula-name"><span class="eyebrow">AULA {String(entrada.aula).padStart(2,'0')} · GÊNESIS {entrada.faixa}</span><strong>{entrada.original.titulo}</strong></span><span class="pdf-aula-open">Ver conteúdo</span></summary>
      <div class="pdf-aula-body">
        <span class="eyebrow">Explicações e contexto</span>
        {entrada.original.secoes.map((s,j)=><section class="pdf-topic" id={'aula-'+entrada.aula+'-topico-'+(j+1)}><h3>{s.titulo}</h3><p>{s.texto}</p></section>)}
        <h3 class="pdf-part-heading">Referências cruzadas com o conteúdo das passagens</h3>
        {entrada.original.referencias.map(r=><div class="pdf-ref"><strong>{r.referencia}</strong><small>Resumo da referência bíblica</small><blockquote>“{r.texto}”</blockquote><p><span class="gold">Conexão:</span> {r.conexao}</p></div>)}
        <h3 class="pdf-part-heading">Notas do material de origem</h3>
        <p>{entrada.original.registro}</p>
        <div class="controls"><a class="btn secondary small" href={'/estudos/'+entrada.aula+'/'}>Abrir página da Aula {String(entrada.aula).padStart(2,'0')} →</a></div>
      </div>
    </details>)}
  </section>
  {capitulo===3&&<div class="notice" style="margin-top:22px">Gênesis 3:14–24 já está disponível para leitura. O aprofundamento publicado chega até 3:13; a próxima etapa será Gênesis 3:14–15.</div>}
  <div class="chapter-navigation">
    {capitulo>1?<a href={'/livros/genesis/'+(capitulo-1)+'/'} class="btn secondary">← Capítulo {capitulo-1}</a>:<a href="/livros/genesis/" class="btn secondary">← Livro de Gênesis</a>}
    {capitulo<3?<a href={'/livros/genesis/'+(capitulo+1)+'/'} class="btn">Capítulo {capitulo+1} →</a>:<a href="/estudos/debates/" class="btn">Questões em aberto →</a>}
  </div>

  <dialog id="verse-preview" aria-labelledby="preview-heading">
    <div class="modal-head"><div><span class="eyebrow">Prévia do versículo</span><h2 id="preview-heading">Gênesis</h2></div><button class="btn secondary small" type="button" id="preview-close">✕ Fechar</button></div>
    <div class="verse-box" id="preview-text"></div>
    <p class="muted" id="preview-lessons" style="margin-top:15px"></p>
    <div class="controls"><a class="btn" id="preview-study" href="#">Abrir estudo completo →</a><button class="btn secondary" id="preview-read" type="button">✓ Marcar como lido</button></div>
    <p class="muted" style="font-size:12px">Seu progresso é salvo apenas neste navegador.</p>
  </dialog>
</Base>
<style>
.reading-note{display:flex;flex-wrap:wrap;align-items:center;gap:10px;background:var(--card);border:1px solid var(--line);border-radius:11px;padding:13px 16px;font-size:12px;color:var(--muted)}.reading-note strong{color:var(--text)}.reading-note a{color:var(--gold);text-decoration:underline}
.chapter-toolbar{display:flex;align-items:center;flex-wrap:wrap;gap:11px;margin:23px 0}.chapter-toolbar label{font-size:13px;color:var(--muted)}.read-status{margin-left:auto;font-size:12px;color:var(--muted)}
.chapter-reader{background:var(--card2);border:1px solid var(--line);border-radius:14px;padding:30px 28px;font-family:Georgia,serif;font-size:21px;line-height:2.06}.read-verse{display:inline;background:transparent;border:0;padding:2px 3px;margin:0;color:var(--text);font:inherit;text-align:left;white-space:normal;line-height:inherit}.read-verse:hover,.read-verse:focus-visible{background:#3a3127;border-radius:4px;outline:1px solid var(--gold)}.read-verse .v-num{display:inline;color:var(--gold);font:700 12px Inter,system-ui,sans-serif;vertical-align:super;margin-right:6px}.v-text{display:inline}.read-indicator{font-size:12px;color:var(--green);margin-left:3px}.read-verse.read-marked .read-indicator::after{content:'✓'}
.chapter-reader.separated{display:grid;gap:11px;background:transparent;border:0;padding:0}.separated .read-verse{display:block;border:1px solid var(--line);background:var(--card);padding:16px 20px;border-radius:11px}.separated .read-verse:hover{border-color:var(--gold)}.lesson{display:flex;flex-direction:column;gap:9px}.genesis1-route{margin:34px 0}.genesis1-route-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}.genesis1-route-card{display:flex;flex-direction:column;gap:7px;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px 18px}.genesis1-route-card:hover{border-color:var(--gold)}.genesis1-route-card strong{font-size:16px}.genesis1-route-card .gold{font-size:12px;margin-top:auto}.genesis1-route-note{font-size:12px;line-height:1.6;margin-top:14px}@media(max-width:650px){.genesis1-route-grid{grid-template-columns:1fr}}
.chapter-debates{margin-top:38px}.debate-details{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px 18px}.debate-details summary{color:var(--gold);font-size:14px;font-weight:600;cursor:pointer}.debate-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;padding-top:15px}.debate-link{border:1px solid var(--line);border-radius:9px;padding:13px;display:grid;gap:6px}.debate-link:hover{border-color:var(--gold)}.debate-link strong{font-size:14px}.debate-link .gold{font-size:12px}.all-debates-link{display:inline-block;color:var(--gold);font-size:13px;margin:16px 0 3px}@media(max-width:700px){.debate-grid{grid-template-columns:1fr}}
.pdf-studies{margin-top:48px}.pdf-aula{margin:13px 0;background:var(--card);border:1px solid var(--line);border-radius:13px;overflow:hidden}.pdf-aula[open]{border-color:#796344}.pdf-aula summary{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:20px;cursor:pointer;list-style:none}.pdf-aula summary::-webkit-details-marker{display:none}.pdf-aula summary:hover{background:#2d302f}.pdf-aula-name{display:grid;gap:4px}.pdf-aula-name strong{font-size:18px}.pdf-aula-open{color:var(--gold);font-size:12px;white-space:nowrap}.pdf-aula[open] .pdf-aula-open{display:none}.pdf-aula-body{border-top:1px solid var(--line);padding:18px 22px 24px}.pdf-topic{margin:18px 0;padding:17px 20px;background:var(--card2);border:1px solid var(--line);border-radius:10px}.pdf-topic h3{color:var(--gold);margin-bottom:8px}.pdf-topic p{line-height:1.8;white-space:pre-line}.pdf-part-heading{font-size:18px;margin:26px 0 13px}.pdf-ref{padding:14px 0;border-bottom:1px solid var(--line)}.pdf-ref>strong{color:var(--text);display:block}.pdf-ref small{color:var(--muted);font-size:11px}.pdf-ref blockquote{font:17px/1.8 Georgia,serif;margin:9px 0;padding-left:14px;border-left:2px solid var(--gold)}.pdf-ref p{font-size:13px;color:var(--muted)}.lesson .gold{margin-top:auto;font-size:13px}.chapter-navigation{display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap;margin-top:32px}
dialog{width:min(670px,calc(100vw - 24px));max-height:90vh;overflow:auto;padding:25px;border:1px solid #705d43;border-radius:15px;color:var(--text);background:var(--card);box-shadow:0 25px 90px #000b}dialog::backdrop{background:#000b}.modal-head{display:flex;justify-content:space-between;gap:15px;align-items:start;margin-bottom:17px}.modal-head h2{margin-top:5px}
@media(max-width:700px){.chapter-reader{padding:15px;font-size:18px}.read-status{width:100%;margin-left:0}.chapter-navigation .btn{flex:1}dialog{padding:18px}}@media(max-width:430px){.chapter-navigation{flex-direction:column}}
</style>
<script>
import { getVerse, markRead } from '../scripts/progresso.js';
const root=document.querySelector('[data-chapter-id]');
if(root){
 const cap=Number(root.dataset.chapterId),reader=document.getElementById('chapter-reader');
 const mode=document.getElementById('reading-mode');
 const modal=document.getElementById('verse-preview');
 const all=[...reader.querySelectorAll('[data-verse]')];let active=1;
 try{mode.value=localStorage.getItem('atlas:mode:genesis')||'continua';}catch{}
 function renderMode(){reader.classList.toggle('separated',mode.value==='separada');}
 mode.addEventListener('change',()=>{renderMode();try{localStorage.setItem('atlas:mode:genesis',mode.value);}catch{}});renderMode();
 function renderRead(){
   let count=0;
   for(const b of all){const yes=getVerse(cap,Number(b.dataset.verse)).read;b.classList.toggle('read-marked',yes);if(yes)count++;}
   document.getElementById('read-status').textContent=count+' de '+all.length+' lidos neste navegador';
 }
 function close(){modal.close();}
 for(const button of all)button.addEventListener('click',()=>{
   active=Number(button.dataset.verse);
   document.getElementById('preview-heading').textContent='Gênesis '+cap+':'+active;
   document.getElementById('preview-text').textContent=button.querySelector('[data-verse-text]').textContent;
   document.getElementById('preview-lessons').textContent=button.dataset.studied==='1'
     ?'Estudo aprofundado: '+button.dataset.lesson+'.'
     :'Este versículo já pode ser lido; o aprofundamento ainda não foi publicado.';
   const study=document.getElementById('preview-study');
   study.href='/livros/genesis/'+cap+'/'+active+'/';
   study.textContent=button.dataset.studied==='1'?'Abrir seis módulos →':'Abrir página do versículo →';
   document.getElementById('preview-read').textContent=getVerse(cap,active).read?'✓ Já marcado como lido':'✓ Marcar como lido';
   modal.showModal();
 });
 document.getElementById('preview-read').addEventListener('click',()=>{
   markRead(cap,active);renderRead();
   document.getElementById('preview-read').textContent='✓ Já marcado como lido';
 });
 document.getElementById('preview-close').addEventListener('click',close);
 modal.addEventListener('click',e=>{if(e.target===modal)close();});
 renderRead();
}
</script>
