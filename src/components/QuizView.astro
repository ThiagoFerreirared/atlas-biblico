---
import Base from '../layouts/Base.astro';
import { questoesPorCapitulo } from '../data/avaliacoes.js';
const {capitulo}=Astro.props;
const questions=questoesPorCapitulo[capitulo]||[];
const abertas={
  1:[
    {pergunta:'Qual é a relação entre Gênesis 1 e João 1?',modelo:'João retoma deliberadamente a linguagem do princípio, mas apresenta o Verbo em uma releitura cristológica; não se trata da mesma narrativa. Fonte: Aula 6.'},
    {pergunta:'O que o texto permite dizer sobre imagem e semelhança em Gênesis 1:26–27?',modelo:'Homem e mulher são criados à imagem divina. Tselem e demut descrevem imagem/representação e semelhança/correspondência. O plural façamos não detalha explicitamente a Trindade. Fonte: Aula 14.'}
  ],
  2:[
    {pergunta:'Por que nefesh chayyah não resolve sozinho o debate sobre a alma?',modelo:'A expressão “ser vivente” também se aplica aos animais; a Aula 17 distingue abordagens holística, dicotômica e tricotômica sem deduzi-las apenas de Gênesis 2:7.'},
    {pergunta:'O que está estabelecido e o que permanece incerto sobre o Éden?',modelo:'O texto menciona quatro rios. Tigre e Eufrates são conhecidos, mas Pisom, Giom e uma localização arqueológica comprovada do jardim permanecem incertos. Fonte: Aula 18.'}
  ],
  3:[
    {pergunta:'Qual a diferença entre a serpente de Gênesis 3 e sua interpretação posterior?',modelo:'Gênesis a chama de nachash, serpente astuta, e não a identifica explicitamente como Satanás; Apocalipse 12:9 e 20:2 desenvolvem a identificação cristã. Fonte: Aula 22.'},
    {pergunta:'Por que a pergunta “Onde estás?” não implica necessariamente ignorância divina?',modelo:'Ela pode funcionar como convocação para o homem responder. A narrativa não exige interpretar a pergunta como desconhecimento geográfico. Fonte: Aula 24.'}
  ]
}[capitulo]||[];
---
<Base title={'Avaliação — Gênesis '+capitulo}>
  <div class="breadcrumbs"><a href="/">Biblioteca</a> / <a href="/livros/genesis/">Gênesis</a> / <a href={'/livros/genesis/'+capitulo+'/'}>Capítulo {capitulo}</a> / <span class="gold">Avaliação</span></div>
  <section class="intro"><span class="eyebrow">Revisão de aprendizagem</span><h1>Avaliação de Gênesis {capitulo}</h1><p class="muted">Teste seus conhecimentos com correção imediata, explicações detalhadas e perguntas abertas para autoavaliação.</p></section>
  <p class="notice">As questões de múltipla escolha foram elaboradas para o Atlas com base nas Aulas {capitulo===1?'6–15':capitulo===2?'16–21':'22–24'} do PDF. As perguntas abertas são avaliadas por você, não automaticamente por IA.</p>
  <div class="section-heading"><h2>Parte 1 · Múltipla escolha</h2><span class="tag">{questions.length} questões</span></div>
  <form id="quiz" data-quiz-chapter={capitulo}>
    {questions.map((q,i)=><fieldset class="card question" data-question={i} data-correct={q.correta}>
      <legend><span class="eyebrow">Questão {i+1} / {questions.length}</span></legend>
      <h3>{q.p}</h3>
      <div class="options">{q.opcoes.map((answer,j)=><label class="option"><input type="radio" name={'q'+i} value={j} required/> <span>{answer}</span></label>)}</div>
      <p class="feedback hidden" data-feedback={i}></p><p class="muted explanation hidden" data-explanation={i}>{q.explicacao}</p>
    </fieldset>)}
    <div class="quiz-actions"><button type="submit" id="grade" class="btn">Corrigir respostas</button><button type="button" id="repeat" class="btn secondary" hidden>Refazer avaliação</button><strong id="result" aria-live="polite"></strong></div>
  </form>
  <div id="previous" class="notice" hidden></div>
  <div class="section-heading"><h2>Parte 2 · Reflexão escrita</h2><span class="tag">Autoavaliação</span></div>
  <p class="muted" style="margin-bottom:15px">Escreva suas respostas, compare com as orientações e registre sua percepção. Não existe nota automática para essas questões.</p>
  <div class="written" data-written-chapter={capitulo}>
    {abertas.map((q,i)=><article class="card essay"><span class="eyebrow">Pergunta aberta {i+1}</span><h3>{q.pergunta}</h3><textarea class="field" data-essay={i} rows="4" placeholder="Minha resposta..."></textarea><details><summary>Mostrar orientação de resposta</summary><p>{q.modelo}</p></details><label class="label" for={'self-'+i}>Como você avalia sua compreensão?</label><select id={'self-'+i} class="field" data-self={i}><option value="">Ainda não avaliei</option><option value="compreendi">Consegui explicar com clareza</option><option value="parcial">Compreendi parcialmente</option><option value="revisar">Preciso revisar</option></select></article>)}
  </div>
  <div class="chapter-nav"><a href={'/livros/genesis/'+capitulo+'/'} class="btn secondary">← Voltar ao capítulo</a><a href="/progresso/" class="btn">Meu progresso →</a></div>
</Base>
<style>
.question{display:grid;gap:13px;margin-bottom:17px}.question legend{padding:0 12px}.question h3{font-size:18px}.options{display:grid;gap:9px}.option{display:flex;gap:10px;align-items:flex-start;padding:11px 13px;border:1px solid var(--line);border-radius:9px;cursor:pointer}.option:has(input:checked){border-color:var(--gold);background:#363128}.option input{accent-color:var(--gold);margin-top:5px}.option.correct{border-color:#518b68;background:#203129}.option.wrong{border-color:#b0735c;background:#342723}.feedback{font-weight:700;font-size:13px}.feedback.good{color:var(--green)}.feedback.bad{color:#ef9d7c}.quiz-actions{display:flex;gap:12px;align-items:center;flex-wrap:wrap}.explanation{line-height:1.75}.written{display:grid;gap:14px}.essay{display:grid;gap:11px}.essay h3{font-size:17px}.essay textarea{width:100%;resize:vertical}.essay details{background:var(--card2);padding:11px 13px;border-radius:9px}.essay summary{color:var(--gold);cursor:pointer;font-size:13px}.essay details p{padding-top:12px;font-size:14px;line-height:1.8}.essay select{max-width:360px}.chapter-nav{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-top:27px}@media(max-width:480px){.chapter-nav .btn{flex:1}}
</style>
<script>
import {getQuiz,saveQuiz,getDraft,saveDraft} from '../scripts/progresso.js';
const form=document.getElementById('quiz');
if(form){
 const chapter=Number(form.dataset.quizChapter),fields=[...form.querySelectorAll('[data-question]')],grade=document.getElementById('grade'),repeat=document.getElementById('repeat');
 const prev=document.getElementById('previous');
 const earlier=getQuiz(chapter);if(earlier){prev.hidden=false;prev.textContent='Último resultado salvo: '+earlier.correct+'/'+earlier.total+' · '+new Date(earlier.at).toLocaleDateString('pt-BR')+' · '+(earlier.attempts||1)+' tentativa(s).';}
 function reset(){form.reset();grade.hidden=false;repeat.hidden=true;document.getElementById('result').textContent='';for(const f of fields){f.querySelectorAll('.option').forEach(o=>o.classList.remove('correct','wrong'));f.querySelector('.feedback').classList.add('hidden');f.querySelector('.explanation').classList.add('hidden');f.querySelectorAll('input').forEach(i=>i.disabled=false);}}
 form.addEventListener('submit',e=>{
   e.preventDefault();let score=0;const answers=[];
   for(const f of fields){const chosen=f.querySelector('input:checked');if(!chosen){f.querySelector('input')?.focus();return;}const right=Number(f.dataset.correct),sel=Number(chosen.value);answers.push(sel);if(right===sel)score++;
     const fb=f.querySelector('.feedback');fb.textContent=right===sel?'✓ Resposta correta':'✕ Resposta incorreta';fb.classList.toggle('good',right===sel);fb.classList.toggle('bad',right!==sel);fb.classList.remove('hidden');
     f.querySelector('.explanation').classList.remove('hidden');
     f.querySelectorAll('.option').forEach(o=>{const value=Number(o.querySelector('input').value);o.classList.toggle('correct',value===right);o.classList.toggle('wrong',value===sel&&value!==right);o.querySelector('input').disabled=true;});
   }
   const old=getQuiz(chapter);saveQuiz(chapter,{correct:score,total:fields.length,at:Date.now(),answers,attempts:(old?.attempts||0)+1,best:Math.max(score,old?.best||0)});
   document.getElementById('result').textContent='Resultado: '+score+'/'+fields.length+' ('+Math.round(score/fields.length*100)+'%)';
   grade.hidden=true;repeat.hidden=false;
   prev.hidden=false;prev.textContent='Resultado salvo neste navegador. Melhor pontuação: '+Math.max(score,old?.best||0)+'/'+fields.length+'.';
 });
 repeat.addEventListener('click',reset);
 const written=document.querySelector('[data-written-chapter]');if(written){
   written.querySelectorAll('[data-essay]').forEach(el=>{const key='genesis:'+chapter+':essay:'+el.dataset.essay;el.value=getDraft(key);el.addEventListener('input',()=>saveDraft(key,el.value));});
   written.querySelectorAll('[data-self]').forEach(el=>{const key='genesis:'+chapter+':self:'+el.dataset.self;el.value=getDraft(key);el.addEventListener('change',()=>saveDraft(key,el.value));});
 }
}
</script>
