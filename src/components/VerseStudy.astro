---
import Base from '../layouts/Base.astro';
import { textoVerso, possuiEstudo, gerarConteudoDoVersiculo, modulos, ligaReferencia, urlVerso, totalVersosPorCapitulo } from '../data/estudo.js';
import { textoDaReferencia } from '../data/referencias.js';
import { urlReferencia } from '../data/rotas-referencias.js';
const { capitulo, versiculo }=Astro.props;
const verse=textoVerso(capitulo,versiculo);
const study=gerarConteudoDoVersiculo(capitulo,versiculo);
const has=possuiEstudo(capitulo,versiculo);
const refs=study?.referencias.map((r,i)=>{
  const direto=ligaReferencia(r.referencia);
  const match=r.referencia.match(/^G[eê]nesis\s+(\d+):(\d+)/i);
  const estudo=Boolean(match && direto && possuiEstudo(Number(match[1]),Number(match[2])));
  return {...r,id:i,completo:textoDaReferencia(r.referencia),estudo,
    pagina:estudo?direto+'?voltar='+capitulo+'-'+versiculo:urlReferencia(r.referencia)+'?origem='+capitulo+'-'+versiculo};
})||[];
const prev=versiculo>1?{c:capitulo,v:versiculo-1}:capitulo>1?{c:capitulo-1,v:totalVersosPorCapitulo[capitulo-1]}:null;
const next=versiculo<totalVersosPorCapitulo[capitulo]?{c:capitulo,v:versiculo+1}:capitulo<3?{c:capitulo+1,v:1}:null;
const title='Gênesis '+capitulo+':'+versiculo;
---
<Base title={title+' — Atlas Bíblico'}>
  <div class="breadcrumbs"><a href="/">Biblioteca</a> / <a href="/livros/genesis/">Gênesis</a> / <a href={'/livros/genesis/'+capitulo+'/'}>Capítulo {capitulo}</a> / <span class="gold">Versículo {versiculo}</span></div>
  <section class="intro"><span class="eyebrow">Livro de Gênesis · Capítulo {capitulo} · Versículo {versiculo}</span><h1>{title}</h1><p class="muted">{has?'Leia as explicações por assunto, com o conteúdo do estudo original organizado dentro dos módulos.':'Texto bíblico disponível · A análise deste versículo ainda não foi publicada.'}</p></section>
  <div class="verse-box main-verse">“{verse.texto}”</div>
  <p class="source">Texto: Bíblia Livre (BLIVRE), © Diego Santos, Mario Sérgio e Marco Teles, 2018. <a href="https://creativecommons.org/licenses/by/3.0/br/" target="_blank" rel="noopener noreferrer">CC BY 3.0 Brasil</a>.</p>
  <div class="verse-actions"><a class="btn secondary small" href={'/livros/genesis/'+capitulo+'/#v-'+versiculo}>← Voltar ao capítulo, versículo {versiculo}</a><a id="back-to-connection" class="btn secondary small hidden" href="/livros/genesis/1/1/">← Voltar ao estudo de origem</a><button class="btn secondary small" id="mark-read" type="button">Marcar como lido</button><a class="btn secondary small" href="/progresso/">Meu progresso</a></div>

  {has ? <>
    <div class="notice module-guide"><strong>Seu estudo de {title}:</strong> o material das aulas do PDF foi organizado por tema nos módulos abaixo. Abra um assunto para ler a explicação completa. Não há provas nem perguntas obrigatórias.</div>
    <div class="section-heading"><h2>Seis módulos de estudo</h2><span class="tag" id="progress-label">0 de 6 concluídos</span></div>
    <div class="progress-line"><div id="progress-fill"></div></div>
    <div class="grid two module-grid">
      {modulos.map((m,i)=><button type="button" class="card module" data-module={m.id} data-state="todo"><div class="module-top"><span class="module-symbol">{m.icone}</span><span class="module-status">Não iniciado</span></div><h3>{String(i+1).padStart(2,'0')} · {m.titulo}</h3><p class="muted">{m.id==='conexoes' ? (refs.length ? refs.length+' passagens relacionadas ao versículo' : 'Referências do estudo') : (study[m.id]?.[0]?.titulo==='Sem estudo específico no PDF' ? 'O PDF não traz um tópico específico aqui' : study[m.id]?.[0]?.titulo || m.descricao)}</p><span class="gold">Ler explicação →</span></button>)}
    </div>
    <p class="notice hidden" id="verse-complete" style="margin-top:20px">✓ Todos os seis módulos concluídos! Este versículo entrou no ciclo opcional de revisão espaçada.</p>

    <details class="private-notes">
      <summary>Minhas anotações (opcional)</summary>
      <label class="label" for="verse-note">Observações pessoais sobre {title} · salvas no navegador</label>
      <textarea class="field personal-notes" id="verse-note" rows="4" placeholder="Anote o que você achou importante neste versículo..."></textarea>
    </details>
    <details class="source-details">
      <summary>Consultar o material original deste estudo</summary>
      <p>{study.nota} O conteúdo integral do PDF permanece preservado no acervo.</p>
      {study.aulas.map(t=><a href={'/estudos/'+t.aula.numero+'/'} class="source-link">Aula {String(t.aula.numero).padStart(2,'0')} · Gênesis {t.faixa} · consultar original →</a>)}
    </details>
  </> : <>
    <div class="notice" style="margin-top:22px">Este versículo tem texto completo para leitura, mas ainda não possui análise nas 24 aulas importadas. O estudo consolidado termina em Gênesis 3:13; a Aula 25 começará em 3:14–15. Os seis módulos serão disponibilizados somente quando houver material correspondente.</div>
    <a href="/estudos/24/" class="btn secondary" style="margin-top:18px">Consultar a última aula publicada →</a>
  </>}
  <div class="chapter-nav">
    {prev?<a href={urlVerso(prev.c,prev.v)} class="btn secondary">← {prev.c}:{prev.v}</a>:<a href={'/livros/genesis/'+capitulo+'/'} class="btn secondary">← Voltar ao capítulo</a>}
    <a class="btn secondary" href={'/livros/genesis/'+capitulo+'/#v-'+versiculo}>Leitura do capítulo</a>
    {next?<a href={urlVerso(next.c,next.v)} class="btn">Próximo · {next.c}:{next.v} →</a>:<a href="/livros/genesis/" class="btn">Fim do capítulo 3 →</a>}
  </div>

  {has && <>
    {modulos.map(m=><template id={'template-'+m.id}>
      {m.id==='conexoes'
        ? (refs.length
          ? refs.map((r,i)=><section class="study-part connection-entry" id={'part-'+i}>
              <h3>{r.referencia}</h3>
              {r.completo
                ? <>
                  <div class="connection-scripture">
                    {r.completo.versiculos.slice(0,3).map(v=><p><span class="passage-number">{v.numero}</span>{v.texto}</p>)}
                    {r.completo.versiculos.length>3&&<details class="connection-more">
                      <summary>Mostrar mais {r.completo.versiculos.length-3} versículos</summary>
                      {r.completo.versiculos.slice(3).map(v=><p><span class="passage-number">{v.numero}</span>{v.texto}</p>)}
                    </details>}
                  </div>
                </>
                : <div class="connection-scripture"><p>“{r.texto}”</p><p class="muted" style="font:12px/1.5 system-ui">Paráfrase de estudo do PDF; o texto integral desta referência ainda não está disponível aqui.</p></div>}
              <a class="btn secondary small connection-open" href={r.pagina}>{r.estudo?'Estudar este versículo no Atlas →':'Ir para esta passagem no Atlas →'}</a>
            </section>)
          : <section class="study-part" id="part-0"><h3>Sem conexão específica registrada</h3><p>O PDF não traz uma conexão bíblica atribuída diretamente a este versículo. Consulte a aula completa para conferir as referências do trecho.</p></section>)
        : (study[m.id]||[]).map((section,i)=><section class="study-part" id={'part-'+i}><span class="part-origin">{section.origem}</span><h3>{section.titulo}</h3><p>{section.texto}</p></section>)}
    </template>)}
    <dialog id="module-dialog" aria-labelledby="module-heading">
      <header class="modal-header"><div><span id="modal-step" class="eyebrow"></span><h2 id="module-heading"></h2></div><button type="button" id="module-close" class="btn secondary small">✕ Fechar</button></header>
      <div class="module-scripture"><span class="eyebrow">{title} · texto bíblico</span><p>{verse.texto}</p></div>
      <p id="modal-description" class="muted" style="margin-top:14px"></p><p class="modal-guide">As explicações abaixo vêm dos estudos do PDF e estão organizadas pelo assunto deste versículo. Ao terminar, você pode marcar este módulo como lido.</p>
      <div class="panel-index-title">EXPLICAÇÕES DESTE VERSÍCULO</div><nav class="panel-index" id="panel-index" aria-label="Índice dos assuntos deste módulo"></nav>
      <div id="module-body"></div>
      <div class="modal-bottom"><button type="button" class="btn" id="module-done">✓ Concluir e fechar</button><button type="button" class="btn secondary" id="module-next">Próximo módulo →</button></div>
    </dialog>

  </>}
</Base>
<style is:global>
.main-verse{margin-bottom:10px}.source{font-size:12px;color:var(--muted);line-height:1.6;margin-bottom:16px}.source a{color:var(--gold);text-decoration:underline}.verse-actions,.lesson-links,.chapter-nav{display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin:18px 0 25px}
.module-scripture{background:#1b1e21;border-left:3px solid var(--gold);border-radius:8px;padding:14px 17px}.module-scripture p{font:18px/1.75 Georgia,serif;margin:7px 0 0}.private-notes,.source-details{margin-top:18px;border:1px solid var(--line);border-radius:11px;padding:15px 18px;background:var(--card2)}.private-notes summary,.source-details summary{cursor:pointer;color:var(--gold);font-size:14px;font-weight:600}.private-notes label{margin:15px 0 8px}.source-details p{font-size:13px;color:var(--muted);padding:12px 0}.source-link{display:block;padding:8px 0;color:var(--gold);font-size:13px}.source-link:hover{text-decoration:underline}
.progress-line{height:7px;background:#33383d;border-radius:12px;margin:0 0 17px;overflow:hidden}.progress-line>div{height:100%;width:0;background:var(--gold);transition:width .2s}
.module{text-align:left;color:var(--text);display:flex;flex-direction:column;gap:8px}.module{min-height:170px}.module h3{font-size:17px}.module p{font-size:13px}.module .gold{font-size:12px;margin-top:auto;font-weight:650}.module-top{display:flex;align-items:center;justify-content:space-between;gap:10px}.module-symbol{font-size:23px;color:var(--gold)}.module-status{font-size:11px;color:var(--muted)}.module[data-state="in-progress"] .module-status{color:var(--gold)}.module[data-state="done"]{border-color:#47775b}.module[data-state="done"] .module-status{color:var(--green)}.module[data-state="done"] .module-status::before{content:'✓ ';color:var(--green)}
.module-guide{margin:14px 0 22px}.modal-guide{font-size:13px;color:var(--muted);border-left:2px solid var(--gold);padding:9px 12px;margin:15px 0;line-height:1.65}.modal-guide strong{color:var(--text)}.panel-index-title{font-size:10px;color:var(--muted);letter-spacing:.12em;font-weight:700;margin-top:18px}.personal-notes{display:block;width:100%;resize:vertical}.chapter-nav{justify-content:space-between;margin-top:38px}
#module-dialog{width:min(840px,calc(100vw - 26px));max-height:91dvh;overflow:auto;background:var(--card);border:1px solid #755e3e;border-radius:15px;color:var(--text);padding:26px;box-shadow:0 25px 90px #000b}#module-dialog::backdrop{background:#000c}
.modal-header{display:flex;justify-content:space-between;gap:15px;align-items:start;margin-bottom:16px}.modal-header h2{margin-top:5px}.panel-index{display:flex;flex-wrap:wrap;gap:8px;margin:6px 0 18px;padding:13px;background:var(--card2);border:1px solid var(--line);border-radius:11px}.panel-index a{font-size:12px;padding:5px 9px;color:var(--gold);border:1px solid #524633;border-radius:7px}.study-part{background:var(--card2);border:1px solid var(--line);border-radius:12px;padding:20px;margin-bottom:13px;scroll-margin-top:25px}.study-part .part-origin{font-size:11px;color:var(--muted)}.study-part h3{font-size:19px;margin:6px 0 11px}.study-part p{white-space:pre-line;line-height:1.85}.modal-bottom{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}.full-passage{padding:18px;background:var(--card2);border:1px solid var(--line);border-radius:12px;font:19px/1.85 Georgia,serif;margin:14px 0}.full-passage p+p{margin-top:7px}.passage-number{font:700 12px Inter,system-ui,sans-serif;color:var(--gold);margin-right:6px}.passage-name{font-size:22px;color:var(--text)}.connection-entry h3{font-size:20px;margin:6px 0 12px;color:var(--gold)}
.connection-scripture{background:#1a1e20;border:1px solid var(--line);border-radius:10px;padding:16px 18px;font:18px/1.85 Georgia,serif;color:var(--text)}
.connection-scripture p{white-space:normal;line-height:1.85}.connection-scripture p+p{margin-top:8px}
.connection-scripture .passage-number{display:inline-block;min-width:22px;vertical-align:baseline;margin-right:6px}
.connection-more{margin-top:13px;border-top:1px solid var(--line);padding-top:12px}
.connection-more summary{font:600 13px/1.6 system-ui;color:var(--gold);cursor:pointer;margin-bottom:10px}
.connection-open{display:inline-flex;margin-top:14px}.connection-entry{padding:19px}.connection-entry h3{margin-top:0}.connection-entry .connection-scripture{margin-top:10px}
.connection-entry .source{margin-top:8px;margin-bottom:0}
.connection-reason{border-left:3px solid var(--gold);padding:13px 17px;margin:19px 0;background:#282722}.connection-reason p{margin-top:9px;line-height:1.7}
@media(max-width:650px){#module-dialog{width:100vw;max-width:none;height:100dvh;max-height:100dvh;border-radius:0;padding:18px;margin:0}.modal-bottom .btn{flex:1}.chapter-nav .btn{flex:1}.lesson-link{width:100%}}
</style>
<script>
import { getVerse, markRead, markOpened, markDone, saveDraft, getDraft } from '../scripts/progresso.js';
const headline=document.querySelector('.main-verse');
if(headline){
 const back=document.querySelector('.breadcrumbs');
 const pieces=back?.textContent?.match(/Capítulo\s*(\d+).*Versículo\s*(\d+)/s);
 const chapter=pieces?Number(pieces[1]):Number(document.querySelector('[data-cap]')?.dataset.cap);
 const number=pieces?Number(pieces[2]):Number(document.querySelector('[data-verse-num]')?.dataset.verseNum);
 const ids=['textual','historico','conexoes','interpretacoes','arqueologia','revisao'];
 markRead(chapter,number);
 document.getElementById('mark-read')?.addEventListener('click',()=>{markRead(chapter,number);document.getElementById('mark-read').textContent='✓ Lido';});
 document.getElementById('mark-read').textContent='✓ Lido';
 const notes=document.getElementById('verse-note');
 if(notes){const key='genesis:'+chapter+':'+number+':nota';notes.value=getDraft(key);notes.addEventListener('input',()=>saveDraft(key,notes.value));}
 const backToSource=document.getElementById('back-to-connection');
 const returnParam=new URLSearchParams(location.search).get('voltar');
 const returnMatch=returnParam?.match(/^([123])-([1-9]\d?)$/);
 if(backToSource&&returnMatch){
   const origCap=Number(returnMatch[1]),origVerse=Number(returnMatch[2]);
   if((origCap===1&&origVerse<=31)||(origCap===2&&origVerse<=25)||(origCap===3&&origVerse<=24)){
     backToSource.href='/livros/genesis/'+origCap+'/'+origVerse+'/';
     backToSource.textContent='← Voltar a Gênesis '+origCap+':'+origVerse;
     backToSource.classList.remove('hidden');
   }
 }
 const tiles=[...document.querySelectorAll('[data-module]')];
 const modal=document.getElementById('module-dialog');
 let active=0;
 function formatDate(v){return new Date(v).toLocaleDateString('pt-BR',{day:'2-digit',month:'short',year:'numeric'});}
 function render(){
   const p=getVerse(chapter,number);
   const label=document.getElementById('progress-label');
   if(label)label.textContent=p.done.length+' de 6 concluídos';
   const fill=document.getElementById('progress-fill');if(fill)fill.style.width=(p.done.length/6*100)+'%';
   const complete=document.getElementById('verse-complete');if(complete)complete.classList.toggle('hidden',p.done.length!==6);
   tiles.forEach(tile=>{const id=tile.dataset.module;const state=p.done.includes(id)?'done':p.opened.includes(id)?'in-progress':'todo';tile.dataset.state=state;tile.querySelector('.module-status').textContent=state==='done'?'Concluído':state==='in-progress'?'Em andamento':'Não iniciado';});

 }
 function openModule(index){
   active=index;const id=ids[index];markOpened(chapter,number,id);
   const title=tiles[index].querySelector('h3').textContent;
   document.getElementById('module-heading').textContent=title;
   document.getElementById('modal-step').textContent='LIVRO DE GÊNESIS · CAPÍTULO '+chapter+' · VERSÍCULO '+number+' · MÓDULO '+(index+1)+'/6';
   document.getElementById('modal-description').textContent=tiles[index].querySelector('p').textContent;
   const tpl=document.getElementById('template-'+id);
   const body=document.getElementById('module-body');body.replaceChildren(tpl.content.cloneNode(true));
   const nav=document.getElementById('panel-index');nav.replaceChildren();
   [...body.querySelectorAll('.study-part')].forEach((part,i)=>{
     const anchor=document.createElement('a');anchor.href='#part-'+i;anchor.textContent=(i+1)+'. '+part.querySelector('h3').textContent;
     anchor.addEventListener('click',e=>{e.preventDefault();part.scrollIntoView({behavior:'smooth',block:'start'});});
     nav.append(anchor);
   });
   document.getElementById('module-next').disabled=index===5;
   if(!modal.open)modal.showModal();modal.scrollTop=0;render();
 }
 tiles.forEach((t,i)=>t.addEventListener('click',()=>openModule(i)));
 document.getElementById('module-close')?.addEventListener('click',()=>modal.close());
 document.getElementById('module-done')?.addEventListener('click',()=>{markDone(chapter,number,ids[active]);modal.close();render();});
 document.getElementById('module-next')?.addEventListener('click',()=>{if(active<5)openModule(active+1);});
 modal?.addEventListener('click',e=>{if(e.target===modal)modal.close();});
 render();
}
</script>
