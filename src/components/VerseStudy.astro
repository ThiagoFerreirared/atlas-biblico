---
import Base from '../layouts/Base.astro';
import { textoVerso, possuiEstudo, gerarConteudoDoVersiculo, modulos, ligaReferencia, urlVerso, totalVersosPorCapitulo } from '../data/estudo.js';
import { textoDaReferencia } from '../data/referencias.js';
const { capitulo, versiculo }=Astro.props;
const verse=textoVerso(capitulo,versiculo);
const study=gerarConteudoDoVersiculo(capitulo,versiculo);
const has=possuiEstudo(capitulo,versiculo);
const refs=study?.referencias.map((r,i)=>({...r,id:i,completo:textoDaReferencia(r.referencia),destino:ligaReferencia(r.referencia)}))||[];
const prev=versiculo>1?{c:capitulo,v:versiculo-1}:capitulo>1?{c:capitulo-1,v:totalVersosPorCapitulo[capitulo-1]}:null;
const next=versiculo<totalVersosPorCapitulo[capitulo]?{c:capitulo,v:versiculo+1}:capitulo<3?{c:capitulo+1,v:1}:null;
const title='Gênesis '+capitulo+':'+versiculo;
---
<Base title={title+' — Atlas Bíblico'}>
  <div class="breadcrumbs"><a href="/">Biblioteca</a> / <a href="/livros/genesis/">Gênesis</a> / <a href={'/livros/genesis/'+capitulo+'/'}>Capítulo {capitulo}</a> / <span class="gold">Versículo {versiculo}</span></div>
  <section class="intro"><span class="eyebrow">Estudo versículo por versículo</span><h1>{title}</h1><p class="muted">{has?'Explore a análise das aulas consolidadas, conexões bíblicas e sua revisão pessoal.':'Texto bíblico disponível · Estudo ainda não incluído na edição consolidada.'}</p></section>
  <div class="verse-box main-verse">“{verse.texto}”</div>
  <p class="source">Texto: Bíblia Livre (BLIVRE), © Diego Santos, Mario Sérgio e Marco Teles, 2018. <a href="https://creativecommons.org/licenses/by/3.0/br/" target="_blank" rel="noopener noreferrer">CC BY 3.0 Brasil</a>.</p>
  <div class="verse-actions"><a class="btn secondary small" href={'/livros/genesis/'+capitulo+'/#v-'+versiculo}>← Voltar ao capítulo, versículo {versiculo}</a><button class="btn secondary small" id="mark-read" type="button">Marcar como lido</button><a class="btn secondary small" href="/progresso/">Meu progresso</a></div>

  {has ? <>
    <div class="notice"><strong>Origem do estudo:</strong> Atlas Bíblico — Aulas 1–24, edição consolidada de 14/11/2026. {study.nota} O conteúdo permanece integralmente disponível nas páginas das aulas.</div>
    <div class="lesson-links">{study.aulas.map(t=><a class="lesson-link" href={'/estudos/'+t.aula.numero+'/'}><span class="eyebrow">Aula {String(t.aula.numero).padStart(2,'0')}</span><strong>Gênesis {t.faixa}</strong><span class="gold">Ler aula completa →</span></a>)}</div>
    <div class="notice module-guide"><strong>Como estudar:</strong> cada módulo responde a uma pergunta diferente sobre o versículo. <strong>Análise textual</strong> explica palavras e tradução; <strong>Contexto histórico</strong> apresenta o ambiente; <strong>Conexões</strong> mostra passagens relacionadas. Abra um módulo, leia e marque como concluído quando terminar.</div>
    <div class="section-heading"><h2>Seis módulos de estudo</h2><span class="tag" id="progress-label">0 de 6 concluídos</span></div>
    <div class="progress-line"><div id="progress-fill"></div></div>
    <div class="grid two module-grid">
      {modulos.map((m,i)=><button type="button" class="card module" data-module={m.id} data-state="todo"><div class="module-top"><span class="module-symbol">{m.icone}</span><span class="module-status">Não iniciado</span></div><h3>{String(i+1).padStart(2,'0')} · {m.titulo}</h3><p class="muted">{m.descricao}</p><span class="gold">Abrir módulo →</span></button>)}
    </div>
    <p class="notice hidden" id="verse-complete" style="margin-top:20px">✓ Todos os seis módulos concluídos! Este versículo entrou no ciclo opcional de revisão espaçada.</p>

    <div class="section-heading"><h2>Conexões bíblicas</h2><span class="tag">{refs.length} referências da fonte</span></div>
    <p class="muted" style="margin-bottom:16px">Clique para ler o texto completo da Bíblia Livre e entender a conexão registrada no PDF.</p>
    <div class="grid two">
      {refs.map(r=><button type="button" class="card ref-card" data-ref={r.id}><span class="eyebrow">Conexão · Aula</span><h3>{r.referencia}</h3><p class="muted">{r.conexao}</p><span class="gold">Ler passagem completa →</span></button>)}
    </div>

    <div class="section-heading"><h2>Reflexão pessoal</h2></div>
    <div class="card"><label class="label" for="verse-note">Minhas anotações sobre {title} (salvas no navegador)</label><textarea class="field personal-notes" id="verse-note" rows="5" placeholder="Registre aqui suas observações, dúvidas e interpretações..."></textarea></div>
    <div class="review-panel" id="review-panel" hidden><h3>Revisão espaçada</h3><p id="review-message" class="muted"></p><button type="button" class="btn secondary" id="review-now">✓ Já revisei este versículo</button></div>
  </> : <>
    <div class="notice" style="margin-top:22px">Este versículo tem texto completo para leitura, mas ainda não possui análise nas 24 aulas importadas. O estudo consolidado termina em Gênesis 3:13; a Aula 25 começará em 3:14–15. Os seis módulos serão disponibilizados somente quando houver material correspondente.</div>
    <a href="/estudos/24/" class="btn secondary" style="margin-top:18px">Consultar a última aula publicada →</a>
  </>}
  <div class="chapter-nav">
    {prev?<a href={urlVerso(prev.c,prev.v)} class="btn secondary">← {prev.c}:{prev.v}</a>:<a href={'/livros/genesis/'+capitulo+'/'} class="btn secondary">← Voltar ao capítulo</a>}
    <a class="btn secondary" href={'/livros/genesis/'+capitulo+'/#v-'+versiculo}>Leitura do capítulo</a>
    {next?<a href={urlVerso(next.c,next.v)} class="btn">Próximo · {next.c}:{next.v} →</a>:<a href="/livros/genesis/" class="btn">Fim do capítulo 3 →</a>}
  </div>

  {has && <>
    {modulos.map(m=><template id={'template-'+m.id}>
      {(study[m.id]||[]).map((section,i)=><section class="study-part" id={'part-'+i}><span class="part-origin">{section.origem}</span><h3>{section.titulo}</h3><p>{section.texto}</p></section>)}
    </template>)}
    {refs.map(r=><template id={'ref-template-'+r.id}>
      <h3 class="passage-name">{r.referencia}</h3>
      {r.completo?<div class="full-passage">{r.completo.versiculos.map(v=><p><span class="passage-number">{v.numero}</span> {v.texto}</p>)}</div>:<p class="muted">Texto completo indisponível nesta versão.</p>}
      <p class="source">Texto bíblico: Bíblia Livre (BLIVRE), CC BY 3.0 Brasil.</p>
      <div class="connection-reason"><span class="eyebrow">Por que esta passagem está conectada?</span><p>{r.conexao}</p><p class="muted" style="font-size:12px">Origem da conexão: {r.origem}. Paráfrase presente no PDF: “{r.texto}”</p></div>
      {r.destino&&<a class="btn secondary" href={r.destino}>Estudar a passagem no Atlas →</a>}
    </template>)}
    <dialog id="module-dialog" aria-labelledby="module-heading">
      <header class="modal-header"><div><span id="modal-step" class="eyebrow"></span><h2 id="module-heading"></h2></div><button type="button" id="module-close" class="btn secondary small">✕ Fechar</button></header>
      <p id="modal-description" class="muted"></p><p class="modal-guide">Leia os tópicos abaixo. Use o índice para ir a um assunto; ao terminar, escolha <strong>Concluir e fechar</strong>. Para avançar sem concluir este módulo, use <strong>Próximo módulo</strong>.</p>
      <div class="panel-index-title">ASSUNTOS DESTE MÓDULO</div><nav class="panel-index" id="panel-index" aria-label="Índice dos assuntos deste módulo"></nav>
      <div id="module-body"></div>
      <div class="modal-bottom"><button type="button" class="btn" id="module-done">✓ Concluir e fechar</button><button type="button" class="btn secondary" id="module-next">Próximo módulo →</button></div>
    </dialog>
    <dialog id="ref-dialog" aria-label="Passagem bíblica relacionada">
      <header class="modal-header"><span class="eyebrow">Conexão bíblica · texto completo</span><button type="button" class="btn secondary small" id="ref-close">✕ Fechar</button></header>
      <div id="ref-body"></div>
      <button type="button" class="btn secondary" id="ref-back" style="margin-top:20px">← Voltar a {title}</button>
    </dialog>
  </>}
</Base>
<style is:global>
.main-verse{margin-bottom:10px}.source{font-size:12px;color:var(--muted);line-height:1.6;margin-bottom:16px}.source a{color:var(--gold);text-decoration:underline}.verse-actions,.lesson-links,.chapter-nav{display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin:18px 0 25px}
.lesson-link{display:grid;gap:4px;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:13px 17px;font-size:13px;min-width:170px}.lesson-link:hover{border-color:var(--gold)}
.progress-line{height:7px;background:#33383d;border-radius:12px;margin:0 0 17px;overflow:hidden}.progress-line>div{height:100%;width:0;background:var(--gold);transition:width .2s}
.module,.ref-card{text-align:left;color:var(--text);display:flex;flex-direction:column;gap:8px}.module{min-height:170px}.module h3,.ref-card h3{font-size:17px}.module p,.ref-card p{font-size:13px}.module .gold,.ref-card .gold{font-size:12px;margin-top:auto;font-weight:650}.module-top{display:flex;align-items:center;justify-content:space-between;gap:10px}.module-symbol{font-size:23px;color:var(--gold)}.module-status{font-size:11px;color:var(--muted)}.module[data-state="in-progress"] .module-status{color:var(--gold)}.module[data-state="done"]{border-color:#47775b}.module[data-state="done"] .module-status{color:var(--green)}.module[data-state="done"] .module-status::before{content:'✓ ';color:var(--green)}
.module-guide{margin:14px 0 22px}.modal-guide{font-size:13px;color:var(--muted);border-left:2px solid var(--gold);padding:9px 12px;margin:15px 0;line-height:1.65}.modal-guide strong{color:var(--text)}.panel-index-title{font-size:10px;color:var(--muted);letter-spacing:.12em;font-weight:700;margin-top:18px}.personal-notes{display:block;width:100%;resize:vertical}.review-panel{border:1px solid #6f563c;border-radius:12px;background:#25231d;padding:20px;margin-top:23px}.review-panel h3{margin-bottom:10px}.review-panel button{margin-top:12px}.chapter-nav{justify-content:space-between;margin-top:38px}
#module-dialog,#ref-dialog{width:min(840px,calc(100vw - 26px));max-height:91dvh;overflow:auto;background:var(--card);border:1px solid #755e3e;border-radius:15px;color:var(--text);padding:26px;box-shadow:0 25px 90px #000b}#module-dialog::backdrop,#ref-dialog::backdrop{background:#000c}
.modal-header{display:flex;justify-content:space-between;gap:15px;align-items:start;margin-bottom:16px}.modal-header h2{margin-top:5px}.panel-index{display:flex;flex-wrap:wrap;gap:8px;margin:6px 0 18px;padding:13px;background:var(--card2);border:1px solid var(--line);border-radius:11px}.panel-index a{font-size:12px;padding:5px 9px;color:var(--gold);border:1px solid #524633;border-radius:7px}.study-part{background:var(--card2);border:1px solid var(--line);border-radius:12px;padding:20px;margin-bottom:13px;scroll-margin-top:25px}.study-part .part-origin{font-size:11px;color:var(--muted)}.study-part h3{font-size:19px;margin:6px 0 11px}.study-part p{white-space:pre-line;line-height:1.85}.modal-bottom{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}.full-passage{padding:18px;background:var(--card2);border:1px solid var(--line);border-radius:12px;font:19px/1.85 Georgia,serif;margin:14px 0}.full-passage p+p{margin-top:7px}.passage-number{font:700 12px Inter,system-ui,sans-serif;color:var(--gold);margin-right:6px}.passage-name{font-size:22px;color:var(--text)}.connection-reason{border-left:3px solid var(--gold);padding:13px 17px;margin:19px 0;background:#282722}.connection-reason p{margin-top:9px;line-height:1.7}
@media(max-width:650px){#module-dialog,#ref-dialog{width:100vw;max-width:none;height:100dvh;max-height:100dvh;border-radius:0;padding:18px;margin:0}.modal-bottom .btn{flex:1}.chapter-nav .btn{flex:1}.lesson-link{width:100%}}
</style>
<script>
import { getVerse, markRead, markOpened, markDone, reviewVerse, saveDraft, getDraft } from '../scripts/progresso.js';
const headline=document.querySelector('.main-verse');
if(headline){
 const back=document.querySelector('.breadcrumbs');
 const pieces=back?.textContent?.match(/Capítulo\s*(\d+).*Versículo\s*(\d+)/s);
 const chapter=pieces?Number(pieces[1]):Number(document.querySelector('[data-cap]')?.dataset.cap);
 const number=pieces?Number(pieces[2]):Number(document.querySelector('[data-verse-num]')?.dataset.verseNum);
 const ids=['textual','historico','conexoes','interpretacoes','arqueologia','revisao'];
 markRead(chapter,number);
 document.getElementById('mark-read')?.addEventListener('click',()=>{markRead(chapter,number);document.getElementById('mark-read').textContent='✓ Lido';});
 document.getElementById('mark-read').textContent='✓ Lido';
 const notes=document.getElementById('verse-note');
 if(notes){const key='genesis:'+chapter+':'+number+':nota';notes.value=getDraft(key);notes.addEventListener('input',()=>saveDraft(key,notes.value));}
 const tiles=[...document.querySelectorAll('[data-module]')];
 const modal=document.getElementById('module-dialog');
 const refDialog=document.getElementById('ref-dialog');
 let active=0;
 function formatDate(v){return new Date(v).toLocaleDateString('pt-BR',{day:'2-digit',month:'short',year:'numeric'});}
 function render(){
   const p=getVerse(chapter,number);
   const label=document.getElementById('progress-label');
   if(label)label.textContent=p.done.length+' de 6 concluídos';
   const fill=document.getElementById('progress-fill');if(fill)fill.style.width=(p.done.length/6*100)+'%';
   const complete=document.getElementById('verse-complete');if(complete)complete.classList.toggle('hidden',p.done.length!==6);
   tiles.forEach(tile=>{const id=tile.dataset.module;const state=p.done.includes(id)?'done':p.opened.includes(id)?'in-progress':'todo';tile.dataset.state=state;tile.querySelector('.module-status').textContent=state==='done'?'Concluído':state==='in-progress'?'Em andamento':'Não iniciado';});
   const review=document.getElementById('review-panel');
   if(review){review.hidden=p.done.length!==6;if(p.done.length===6){
     const message=document.getElementById('review-message'),button=document.getElementById('review-now');
     if(!p.nextReviewAt){message.textContent='Ciclo de revisão (1, 7 e 30 dias) finalizado. Você pode revisitar este estudo livremente.';button.hidden=true;}
     else{const due=p.nextReviewAt<=Date.now();message.textContent=due?'Revisão disponível! Registre que você reviu o conteúdo.':'Próxima revisão sugerida: '+formatDate(p.nextReviewAt)+'.';button.hidden=!due;}
   }}
 }
 function openModule(index){
   active=index;const id=ids[index];markOpened(chapter,number,id);
   const title=tiles[index].querySelector('h3').textContent;
   document.getElementById('module-heading').textContent=title;
   document.getElementById('modal-step').textContent='GÊNESIS '+chapter+':'+number+' · MÓDULO '+(index+1)+' / 6';
   document.getElementById('modal-description').textContent=tiles[index].querySelector('p').textContent;
   const tpl=document.getElementById('template-'+id);
   const body=document.getElementById('module-body');body.replaceChildren(tpl.content.cloneNode(true));
   const nav=document.getElementById('panel-index');nav.replaceChildren();
   [...body.querySelectorAll('.study-part')].forEach((part,i)=>{
     const anchor=document.createElement('a');anchor.href='#part-'+i;anchor.textContent=(i+1)+'. '+part.querySelector('h3').textContent;
     anchor.addEventListener('click',e=>{e.preventDefault();part.scrollIntoView({behavior:'smooth',block:'start'});});
     nav.append(anchor);
   });
   document.getElementById('module-next').disabled=index===5;
   if(!modal.open)modal.showModal();modal.scrollTop=0;render();
 }
 tiles.forEach((t,i)=>t.addEventListener('click',()=>openModule(i)));
 document.getElementById('module-close')?.addEventListener('click',()=>modal.close());
 document.getElementById('module-done')?.addEventListener('click',()=>{markDone(chapter,number,ids[active]);modal.close();render();});
 document.getElementById('module-next')?.addEventListener('click',()=>{if(active<5)openModule(active+1);});
 document.querySelectorAll('[data-ref]').forEach(button=>button.addEventListener('click',()=>{
   const id=button.dataset.ref,body=document.getElementById('ref-body');
   body.replaceChildren(document.getElementById('ref-template-'+id).content.cloneNode(true));
   refDialog.showModal();
 }));
 document.getElementById('ref-close')?.addEventListener('click',()=>refDialog.close());
 document.getElementById('ref-back')?.addEventListener('click',()=>refDialog.close());
 modal?.addEventListener('click',e=>{if(e.target===modal)modal.close();});
 refDialog?.addEventListener('click',e=>{if(e.target===refDialog)refDialog.close();});
 document.getElementById('review-now')?.addEventListener('click',()=>{reviewVerse(chapter,number);render();});
 render();
}
</script>
